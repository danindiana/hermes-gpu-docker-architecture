digraph PinToSonnetAndReuseCredentials {
  rankdir=LR;
  bgcolor="#0a0e12";
  fontname="Helvetica";
  fontcolor="#dfe6ee";
  label="The fix: pin delegation, reuse an already-live credential pool";
  labelloc="t";
  fontsize=20;
  node [style=filled, fontname="Helvetica", fontcolor="#dfe6ee", shape=box, color="#556070"];
  edge [color="#39ffb0", fontcolor="#ffa93a", fontname="Helvetica", penwidth=1.5];

  config [fillcolor="#0f2a20", color="#39ffb0", penwidth=2.5,
          label="~/.hermes/config.yaml\ndelegation:\n  provider: anthropic\n  model: claude-sonnet-4-6"];

  subgraph cluster_existing {
    label="Already live before this change"; fontcolor="#39d0ff"; color="#39d0ff"; style=dashed; bgcolor="#0d1a22";
    authjson [fillcolor="#152a3a", color="#39d0ff",
              label="~/.hermes/auth.json\ncredential_pool.anthropic\n(real OAuth/API credential)"];
    goaljudge [fillcolor="#152a3a", color="#39d0ff",
               label="auxiliary.goal_judge\nalready using this same pool\n(claude-haiku-4-5-20251001)"];
    authjson -> goaljudge [label="already wired"];
  }

  config -> authjson [label="delegate_task now\nreuses the SAME pool\nno new API key needed", penwidth=2.5, color="#39ffb0"];

  child [fillcolor="#0f2a20", color="#39ffb0", penwidth=2.5,
         label="delegate_task child now runs on\nClaude Sonnet 4.6 (Anthropic)\n1M context / 64K output\n$3 / $15 per M tokens in/out"];
  config -> child;

  verify [shape=note, fillcolor="#152a3a", color="#39d0ff", fontcolor="#dfe6ee",
          label="Verified live, not just config read-back: a real one-shot\ndelegate_task trigger produced a delegation manifest showing\n\"model\": \"claude-sonnet-4-6\", \"provider\": \"anthropic\" —\ncompleted in 1.27s, real API round-trip confirmed."];
  child -> verify [style=invis];
}
